
<!DOCTYPE html>
<html lang="en">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deriv Digit Analyzer</title>
<style>
body {
  background: #101827;
  color: white;
  font-family: Arial, sans-serif;
  padding: 16px;
}
h2 { color: #42e8a5; }
button, select {
  padding: 12px;
  margin: 5px 0;
  border-radius: 8px;
  font-size: 16px;
}
button {
  background: #42e8a5;
  border: none;
  font-weight: bold;
}
.card {
  background: #202d40;
  padding: 14px;
  border-radius: 10px;
  margin-top: 12px;
}
#digits {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
}
.digit {
  background: #34445b;
  text-align: center;
  padding: 12px 2px;
  border-radius: 8px;
}
</style>
</head>
<body>
<h2>Deriv Digit Analyzer</h2>
<p>Live market data • Analysis only</p>

<label for="symbol">Choose market:</label><br>
<select id="symbol">
  <option value="1HZ10V">Volatility 10 (1s)</option>
  <option value="1HZ25V">Volatility 25 (1s)</option>
  <option value="R_10">Volatility 10</option>
  <option value="R_25">Volatility 25</option>
</select><br>

<button id="connect">Connect to live data</button>
<button id="stop">Stop</button>

<div class="card">
  <p>Status: <span id="status">Not connected</span></p>
  <p>Latest price: <strong id="price">--</strong></p>
  <p>Last digit: <strong id="last">--</strong></p>
  <p>Ticks received: <strong id="count">0</strong></p>
</div>

<div class="card">
  <h3>Digit frequency</h3>
  <div id="digits"></div>
  <p id="note">Connect to begin collecting data.</p>
</div>

<script>
const $ = id => document.getElementById(id);
const counts = Array(10).fill(0);
let total = 0;
let socket = null;

function drawDigits() {
  $("digits").innerHTML = counts.map((n, d) =>
    `<div class="digit"><b>${d}</b><br>${n}<br>${
      total ? (n * 100 / total).toFixed(1) : "0.0"
    }%</div>`
  ).join("");
}

drawDigits();

$("connect").onclick = () => {
  if (socket) socket.close();

  $("status").textContent = "Connecting...";
  socket = new WebSocket("wss://ws.derivws.com/websockets/v3?app_id=1089");

  socket.onopen = () => {
    $("status").textContent = "Connected";
    socket.send(JSON.stringify({
      ticks: $("symbol").value,
      subscribe: 1
    }));
  };

  socket.onmessage = event => {
    const data = JSON.parse(event.data);

    if (data.error) {
      $("status").textContent = "Error: " + data.error.message;
      return;
    }

    if (data.tick) {
      const price = data.tick.quote.toFixed(
        data.tick.pip_size ?? 2
      );
      const lastDigit = Number(price.slice(-1));

      $("price").textContent = price;
      $("last").textContent = lastDigit;
      counts[lastDigit]++;
      total++;
      $("count").textContent = total;
      drawDigits();
      $("note").textContent =
        "Percentages show past observed ticks, not future outcomes.";
    }
  };

  socket.onerror = () => {
    $("status").textContent = "Connection error. Try again.";
  };

  socket.onclose = () => {
    $("status").textContent = "Disconnected";
  };
};

$("stop").onclick = () => {
  if (socket) {
    socket.close();
    socket = null;
  }
  $("status").textContent = "Stopped";
};
</script>
</body>
</html>
